server {
    listen 80;
    listen [::]:80;
    server_name {{.ServerNames}};
{{.PageInjectConf}}{{if .DevServerBase}}
    location ^~ {{.DevServerBase}} {
        proxy_pass http://{{.UpstreamHost}}:{{.DevServerPort}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        # Plugin middleware that runs ahead of the tool's own base handling never
        # sees the prefix stripped, so a 404 is retried once without it.
        proxy_intercept_errors on;
        error_page 404 = @lerd_dev_unprefixed;
        error_page 502 = @lerd_dev_down;
    }

    # The page loading these assets may sit on another of the site's domains, and
    # an error without CORS headers reaches its console as a CORS failure instead.
    location @lerd_dev_down {
        default_type text/plain;
        add_header Access-Control-Allow-Origin * always;
        return 502 "lerd: nothing is listening on this site's dev server port ({{.DevServerPort}}). Its worker is stopped or its server has died; start it from the dashboard or see lerd worker list.\n";
    }

    location @lerd_dev_unprefixed {
        rewrite ^{{.DevServerBase}}(.*)$ /$1 break;
        proxy_pass http://{{.UpstreamHost}}:{{.DevServerPort}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{{end}}
    location / {
        set $backend "{{.CustomContainer}}";
        proxy_pass {{if .BackendSSL}}https{{else}}http{{end}}://$backend:{{.CustomPort}};
        proxy_http_version 1.1;
        {{- if .PageInjectConf}}
        # sub_filter cannot rewrite a compressed body.
        proxy_set_header Accept-Encoding "";
        {{- end}}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $real_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $real_forwarded_host;
        proxy_set_header X-Forwarded-Proto $real_forwarded_proto;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout {{.RequestTimeout}}s;
        proxy_send_timeout {{.RequestTimeout}}s;
        {{- if .BackendSSL}}
        proxy_ssl_verify off;
        {{- end}}
        include /etc/nginx/custom.d/{{.Domain}}.location.conf*;
    }

    include /etc/nginx/custom.d/{{.Domain}}.conf*;
}
